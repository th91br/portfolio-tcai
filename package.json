{
  "name": "portfolio-tcai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/launch-all.js",
    "admin": "node scripts/launch-all.js",
    "agent": "node scripts/whatsapp-agent-server.js",
    "typecheck": "npx tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:unit": "npx tsx --test tests/unit/**/*.test.ts",
    "test:integration": "npx tsx --test tests/integration/**/*.test.ts",
    "test:security": "npx tsx --test tests/security/**/*.test.ts",
    "test:perf": "npx tsx --test tests/performance/**/*.test.ts",
    "test:hardening": "npx tsx --test tests/quality/data-stress-resilience.test.ts && npx tsx tests/navigation/hardening-viewports.test.ts",
    "test:navigation": "npx tsx tests/navigation/run-navigation-tests.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:perf && npm run test:hardening && npm run test:navigation",
    "test": "npx tsx --test tests/**/*.test.ts",
    "verify": "node scripts/verify-quality.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "playwright": "^1.63.0",
    "postcss": "^8.5.26",
    "supabase": "^2.116.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@studio-freight/react-lenis": "^0.0.47",
    "@supabase/supabase-js": "^2.114.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "description": "Portfolio Profissional Thiago Cassol Antunes - TCAI"
}
